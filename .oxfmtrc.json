{
  "printWidth": 100,
  "tabWidth": 2,
  "singleQuote": true,
  "bracketSameLine": true,
  "trailingComma": "es5",
  "ignorePatterns": [
    "**/node_modules/**",
    "**/build/**",
    "**/dist/**",
    "**/vendor/**",
    "**/vendored/**",
    "**/__generated__/**",
    "**/fixtures/**",
    "**/__fixtures__/**",
    "**/.expo/**",
    "**/.next/**",
    "**/assets/**",
    "**/android/**",
    "**/ios/**",
    "!**/src/**/android/**",
    "!**/src/**/ios/**",
    "packages/expo-module-template/src/**",
    "packages/expo-module-template/example/**",
    "packages/expo-module-template/$package.json",
    "packages/expo-module-template/expo-module.config.json",
    "react-native-lab/**"
  ],
  "sortImports": {
    "groups": [
      ["builtin", "external"],
      ["internal", "subpath"],
      ["parent", "sibling", "index"],
      "unknown"
    ],
    "ignoreCase": false
  }
}
