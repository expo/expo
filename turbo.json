{
  "$schema": "https://turborepo.dev/schema.json",
  "dangerouslyDisablePackageManagerCheck": true,
  "noUpdateNotifier": true,
  "concurrency": "90%",
  "cacheMaxAge": "10d",
  "cacheMaxSize": "10GB",
  "tasks": {
    "build": {
      "outputs": [
        "build/**",
        "plugin/build/**",
        "cli/build/**",
        "utils/build/**"
      ],
      "outputLogs": "new-only",
      "dependsOn": [
        "^build"
      ]
    },
    "typecheck": {
      "outputs": [
        ".tsbuildinfo",
        "*/.tsbuildinfo"
      ],
      "outputLogs": "new-only"
    },
    "depscheck": {
      "inputs": [
        "package.json",
        "src/**",
        "plugin/src/**",
        "cli/src/**",
        "utils/src/**"
      ],
      "outputLogs": "errors-only"
    },
    "lint": {
      "cache": false
    },
    "format": {
      "cache": false,
      "dependsOn": [
        "lint"
      ]
    },
    "test": {
      "cache": false,
      "outputLogs": "errors-only"
    },
    "precompile-ios": {
      "dependsOn": ["expo-modules-core#precompile-ios"],
      "inputs": [
        "spm.config.json",
        "*.podspec",
        "ios/**",
        "node_modules/react-native/package.json",
        "node_modules/react-native/sdks/hermes-engine/version.properties",
        "$TURBO_ROOT$/tools/src/prebuilds/**"
      ],
      "env": ["RCT_HERMES_V1_ENABLED"],
      "outputs": [".expo-prebuild/output/**"],
      "outputLogs": "new-only"
    }
  },
  "remoteCache": {
    "preflight": true,
    "apiUrl": "https://turbo.exp.host",
    "teamId": "team_expo",
    "teamSlug": "expo"
  }
}
