@@ -32,7 +32,17 @@ def isNewArchitectureEnabled() {
 }
 
 apply plugin: 'com.android.library'
-apply plugin: 'kotlin-android'
+// AGP 9's built-in Kotlin replaces the kotlin-android plugin (applying both fails).
+// Only apply it when built-in Kotlin is unavailable or explicitly disabled with
+// android.builtInKotlin=false.
+// Note: Groovy's ?: operates on truthiness, so a plain `?.toBoolean() ?: true` would
+// coerce an explicit `false` back to true. Check for null explicitly instead.
+def expoBuiltInKotlinProp = findProperty('android.builtInKotlin')
+def expoAgpBuiltInKotlin = com.android.Version.ANDROID_GRADLE_PLUGIN_VERSION.tokenize('.')[0].toInteger() >= 9 &&
+    (expoBuiltInKotlinProp == null || expoBuiltInKotlinProp.toString().toBoolean())
+if (!expoAgpBuiltInKotlin) {
+  apply plugin: 'kotlin-android'
+}
 
 if (isNewArchitectureEnabled()) {
     apply plugin: "com.facebook.react"
