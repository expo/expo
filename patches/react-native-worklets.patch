+// AGP 9's built-in Kotlin replaces the kotlin-android plugin (applying both fails).
+// Only apply the plugin when built-in Kotlin is unavailable or explicitly disabled
+// with android.builtInKotlin=false.
+val agpBuiltInKotlin =
+    com.android.Version.ANDROID_GRADLE_PLUGIN_VERSION.substringBefore(".").toInt() >= 9 &&
+        (findProperty("android.builtInKotlin")?.toString()?.toBoolean() ?: true)
+
+if (!agpBuiltInKotlin) {
+    apply(plugin = "org.jetbrains.kotlin.android")
