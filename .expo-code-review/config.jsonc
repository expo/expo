// @ref LLP 0009#config-and-prompt-templates — root config: agent roster by filename, phase-1 defaults, auth
{
  // Default model for every agent. Anthropic models run through the Claude Code
  // CLI engine (`claude -p`), inferred per agent from the model id — see `auth`
  // below for the credential. Override per-agent via frontmatter in the agent's
  // markdown, or at runtime with the REVIEWER_MODEL env var
  // (e.g. REVIEWER_MODEL=anthropic/claude-haiku-4-5).
  "model": "anthropic/claude-sonnet-5",

  // Agents: every markdown file in agents/ is one reviewer (id = filename).
  // Add or remove files to change the roster — no list needed here.
  // shared.md (prepended to every agent + coordinator) and coordinator.md are
  // reserved filenames. Per-agent overrides go in each file's YAML frontmatter,
  // e.g. `---\nmodel: anthropic/claude-opus-5\n---`.

  // @ref LLP 0009#config-and-prompt-templates [implements] — suggestions off by default, not a schema limit
  "policy": {
    // Phase 1: keep signal high by surfacing only critical/warning.
    "includeSuggestions": false
    // "maxFindings": 10
  },

  // Files to always skip, in addition to the built-in defaults (lockfiles,
  // *.min.js, *.map, __snapshots__/*.snap, @generated markers).
  //
  // This repo is 19.9k tracked files, and a large share of them are generated,
  // vendored, or versioned copies. Reviewing those is pure noise: nobody hand-edits
  // them, so a finding against one is unactionable. Agents can still read/grep these
  // paths on demand — the filter only removes them from the DIFF, which is what lets
  // a reviewer check a change against its vendored twin.
  //
  // Deliberately NOT ignored: packages/expo-router/src/react-navigation/** and
  // src/fork/**. They are vendored upstream code, but this repo actively patches them
  // and review history shows fixes landing in one copy and not its sibling — exactly
  // the defect class a reviewer should catch.
  "noise": {
    "additionalIgnores": [
      // Build output + caches
      "**/build/**",
      "**/dist/**",
      "**/out/**",
      "**/.expo/**",
      "**/.next/**",
      "**/.turbo/**",
      "**/__generated__/**",
      // Generated API surface + data
      "packages/@expo/config-types/src/ExpoConfig.ts",
      "packages/expo/bundledNativeModules.json",
      "changelogVersions.json",
      "docs/public/static/data/**",
      "docs/public/static/diffs/**",
      "template-files/android-paths.json",
      "template-files/ios-paths.json",
      // Versioned docs snapshots (unversioned/ is the live copy and IS reviewed)
      "docs/pages/versions/latest/**",
      "docs/pages/versions/v*/**",
      // Vendored + versioned native code
      "react-native-lab/react-native/**",
      "packages/expo-modules-autolinking/external/**",
      "apps/expo-go/android/versioned-react-native/**",
      "apps/expo-go/ios/versioned/**",
      "**/ios/versioned/**",
      "**/ios/versioned-react-native/**",
      "**/ios/vendored/**",
      "**/vendored/**",
      "**/vendor/**",
      // Native project files nobody reviews by hand
      "**/ios/Pods/**",
      "**/*.xcodeproj/**",
      "**/*.pbxproj",
      "**/gradle/wrapper/gradle-wrapper.jar",
      "**/android/versioned-abis/**",
      // Lockfiles the built-in filter does not name, plus git-crypt'd secrets
      "Gemfile.lock",
      "**/Podfile.lock",
      "THIRD-PARTY-LICENSES",
      "secrets/**"
    ]
  },

  // Bounded documentation research available directly to reviewer and cross-file
  // passes. The built-in MCP sanitizes agent-authored API queries, restricts discovery
  // and direct fetches to fixed official providers, and audits accepted results.
  "research": {
    "enabled": true,
    "maxQueries": 20,
    "resultsPerQuery": 2,
    "timeoutMs": 30000
  },

  // Large diffs are split into focused chunks by changed-line count, plus a
  // cross-cutting pass for multi-file issues. Diffs under maxChangedLines are one
  // full-context pass. Defaults shown; raise/lower per your model + PR sizes.
  // Concurrency defaults by auth mode: 6 with an API key, 3 on a subscription
  // (oauth) credential — one account handles many parallel streams poorly, and
  // several PRs may review on the same credential at once. Set it to override.
  // "chunk": { "maxChangedLines": 1000, "maxFiles": 20, "concurrency": 4 },

  // Which PRs `ecr ci` reviews, and the source of truth for trigger policy.
  //   "trigger": "all"   — review every PR, unless it has the `skipLabel`.
  //   "trigger": "label" — review only PRs labeled `label` (or `label:<agent>`).
  //
  // OPT-IN ONLY here: a PR is reviewed when a maintainer adds `ai-review`, and never
  // otherwise. expo-code-review.yml ALSO gates its job on that label, so a runner does
  // not spin up for every PR in a repo this busy. Both must agree — this file is the
  // real policy and `ecr ci` re-checks it, but if the workflow gate were dropped the
  // config alone would still prevent an unlabeled review.
  //
  // `ai-review:<agent>` narrows a run to one agent (e.g. `ai-review:security`).
  // `skipLabel` is write-gated (only maintainers can add labels), so a PR author
  // cannot opt their own PR out — or in.
  "review": { "trigger": "label", "label": "ai-review", "skipLabel": "ai-review:skip" },

  // A maintainer comment containing this marker skips the CI review.
  "breakGlass": { "marker": "/skip-review" },

  // HTML marker used to find + update the single PR comment. Keep it stable.
  "commentTag": "expo-ai-code-reviewer",

  // How model credentials are provided. Default: Anthropic via the Claude Code
  // CLI. Anthropic models always run through that CLI — the engine is inferred
  // per agent from the `anthropic/…` model id, so this entry only supplies the
  // credential. In CI the tokenEnv holds the review credential (an `sk-ant-oat…`
  // token minted by `claude setup-token`, or an `sk-ant-api…` Console key — the
  // CLI reads either); locally an active `claude` login is enough, and the entry
  // could even be omitted. ECR_EXPECTED_TOKEN_ENV (repo variable / workflow
  // fallback) must equal this tokenEnv. `ecr setup-auth` walks you through it.
  //
  // Other providers run through OpenCode:
  //   "api-key": tokenEnv names the env var holding a provider API key. In CI,
  //              store the key as a repo secret and pass it under that env var.
  //   "auth": { "mode": "api-key", "provider": "openai", "tokenEnv": "OPENAI_API_KEY" }
  //
  //   ChatGPT/Codex subscription ("oauth"): tokenEnv holds the ACCESS token from
  //   an `opencode auth login` ChatGPT sign-in — `ecr setup-auth` extracts it.
  //   NEVER share the refresh token: it is single-use and dies on first rotation.
  //   "auth": { "providers": {
  //     "openai": { "mode": "oauth", "tokenEnv": "CODEX_OAUTH_ACCESS_TOKEN" }
  //   } }
  //
  // MIXING engines is supported: the engine is inferred per agent from its model,
  // so this anthropic entry may coexist with an openai (or any other) OpenCode
  // provider — an `anthropic/…` agent runs through the Claude Code CLI while an
  // `openai/…` agent runs through OpenCode, in the SAME run:
  //   "auth": { "providers": {
  //     "anthropic": { "tokenEnv": "CLAUDE_CODE_REVIEW_EXPO_OSS_API_TOKEN" },
  //     "openai":    { "mode": "oauth", "tokenEnv": "CODEX_OAUTH_ACCESS_TOKEN" }
  //   } }
  //
  // NOTE: whatever you put here must ALSO be named by ECR_EXPECTED_TOKEN_ENV in the two
  // review workflows (and by a repo secret of the same name), or `ecr verify-config`
  // refuses to review. Keep the three in sync.
  "auth": {
    "providers": {
      "anthropic": { "tokenEnv": "CLAUDE_CODE_REVIEW_EXPO_OSS_API_TOKEN" }
    }
  },

  // Stack-aware requalification (ROOT-ONLY; off by default). When on, `ecr ci` walks
  // the OPEN PRs stacked on top of this one and lets the coordinator mark an
  // absence-style finding (a missing test/migration/doc) as addressed when a later
  // stacked PR already adds it. Such findings are never dropped — they render in a
  // collapsed "Addressed in stacked PRs" section, are counted in a visible audit line,
  // and are only excluded from the blocking decision. Critical/secrets/security
  // findings are never requalifiable. Loaded only from the trusted base commit, so a
  // PR cannot enable, widen, or disable its own requalification.
  // "stack": {
  //   "enabled": false,          // turn the feature on
  //   "maxDepth": 4,             // how many levels up the stack to walk
  //   "maxPrs": 8,               // children per level to follow
  //   "maxFilesPerPr": 100,      // per-child file-list cap
  //   "requireSameAuthor": true, // only children by this PR's author (anti-poisoning)
  //   "confirmWithPatch": false, // v2: confirm each requalification against the addressing PR's patch
  //   "maxConfirmations": 10     // v2: max patch confirmations per run (overflow is stripped)
  // }

  // Author feedback (ROOT-ONLY: the comment lifecycle is global). A PR author's
  // reply is matched to the finding it answers (a quoted title and/or an
  // `id:<fp>` token) and recorded in the comment's embedded state. This is ON
  // by default even if you never touch this block, and deliberately ASYMMETRIC:
  // `mode: "annotate"` marks a matched finding "author replied" with a link back
  // to the comment — purely informational, no effect on the pass/fail decision.
  // `dismiss: "never"` keeps it that way: no reply, and no model judgment, can
  // remove a finding from the blocking set until you opt in below. This is
  // deliberate — a repo that never edits this file still gets the useful,
  // read-only behavior, never a surprise auto-dismissal.
  //   "mode": "off" | "annotate" | "adjudicate" — "adjudicate" additionally runs
  //     a model that re-checks the reply against the SOURCE (distrust by
  //     default, like the verifier) and records a verdict.
  //   "dismiss": "never" | "maintainers" | "adjudicated" — who/what may actually
  //     clear a finding: nothing, a maintainer's reply, or (with `adjudicate`) a
  //     maintainer reply OR an author reply the adjudicator confirmed.
  // Clearing always needs the reply to cite the finding's `id:<fp>` token in the
  // replier's OWN words: an id (or a title) inside a `>` quote only annotates,
  // because "Quote reply" copies text the PR author wrote.
  // Critical findings and `protectedCategories` can never be dismissed by a
  // reply, whatever you set here — that floor is enforced in code, not here.
  // "feedback": {
  //   "mode": "annotate",
  //   "match": "both",                              // "quote" | "id" | "both"
  //   "dismiss": "never",
  //   "protectedCategories": ["secrets", "security"],
  //   "maxAdjudications": 10                        // cap on model calls per run
  // }
}
