require File.join(File.dirname(`node --print "require.resolve('react-native-macos/package.json')"`), "scripts/react_native_pods")
require File.join(File.dirname(`node --print "require.resolve('expo/package.json')"`), "scripts/autolinking")

ENV['RCT_NEW_ARCH_ENABLED'] = '1'

prepare_react_native_project!

target 'BareExpo-macOS' do
  platform :macos, '14.0'
  config_command = [
    'node',
    '--no-warnings',
    '--eval',
    'require(\'expo/bin/autolinking\')',
    'expo-modules-autolinking',
    'react-native-config',
    '--json',
    '--platform',
    'ios',
    '--source-dir',
    File.expand_path('.', __dir__)
  ]
  # `--platform ios` above misidentifies `react-native-macos` itself as an autolinkable
  # module, since `list_native_modules!` only ever reads the `ios` key. Strip it out here.
  native_modules_config = list_native_modules!(config_command)
  native_modules_config[:ios_packages] = native_modules_config[:ios_packages].reject do |package|
    package[:name] == 'react-native-macos'
  end
  config = link_native_modules!(native_modules_config)

  use_expo_modules!

  use_react_native!(
    :path => "../node_modules/react-native-macos",
    :hermes_enabled => true,
    :fabric_enabled => ENV['RCT_NEW_ARCH_ENABLED'] == '1',
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    installer.target_installation_results.pod_target_installation_results
      .each do |pod_name, target_installation_result|

      # Set `REACT_NATIVE_PATH` to react-native-macos root node_modules
      target_installation_result.native_target.build_configurations.each do |config|
        config.build_settings["REACT_NATIVE_PATH"] = File.dirname(`node --print "require.resolve('react-native-macos/package.json')"`)
      end
    end

    # Disable fmt's consteval format-string checks, which hit a compiler bug on Xcode 26's Apple Clang.
    fmt_base_header = File.join(installer.sandbox.root, "fmt", "include", "fmt", "base.h")
    if File.exist?(fmt_base_header)
      contents = File.read(fmt_base_header)
      patched = contents.gsub(
        "#elif defined(__apple_build_version__) && __apple_build_version__ < 14000029L",
        "#elif defined(__apple_build_version__)"
      )
      File.write(fmt_base_header, patched) if patched != contents
    end

    react_native_post_install(installer)
  end
end
