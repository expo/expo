context platform=ios
# expo-clipboard: set a string and read it back, check hasStringAsync, then the same for a URL.
# Buttons are FunctionDemo actions, labelled "<function>: <action>". Results render as "<function> = <value>".
open dev.expo.Payments --relaunch
# Wait for the home screen so the deep link is not lost during startup.
wait text "Expo Test Suite" 20000
open "bareexpo://apis/clipboard"
wait text "setStringAsync" 20000
press label="setStringAsync: RUN"
wait text "setStringAsync = true" 10000
press label="getStringAsync: RUN"
wait text "getStringAsync = Hello, world!" 10000
press label="hasXAsync: hasStringAsync"
wait text "hasXAsync = true" 10000
# The URL demos are the last ones on the screen.
scroll bottom
press label="setUrlAsync: RUN"
wait text "setUrlAsync = undefined" 10000
press label="getUrlAsync: RUN"
wait text "getUrlAsync = https://expo.dev" 10000
scroll top
press label="hasXAsync: hasUrlAsync"
wait text "hasXAsync = true" 10000
close
