{
  "expo": {
    "name": "rollipop-expo-example",
    "slug": "rollipop-expo-example",
    "version": "0.0.1",
    "orientation": "portrait",
    "scheme": "exampleapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.app",
      "bundler": "rollipop"
    },
    "android": {
      "package": "com.example.app",
      "bundler": "rollipop"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ]
    ]
  }
}
