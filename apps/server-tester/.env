EXPO_NO_TELEMETRY=1
EXPO_NO_GIT_STATUS=1
# The app resolves to sdkVersion UNVERSIONED in this monorepo. Without this token, `expo export` refuses to run.
EXPO_SKIP_MANIFEST_VALIDATION_TOKEN=0
# Read by `app/+html.tsx` and `app/rendering/env-metadata.tsx`. Only the public value may reach the client bundle.
EXPO_PUBLIC_TEST_VALUE=foobar
EXPO_NOT_PUBLIC_TEST_VALUE=not-public-value
