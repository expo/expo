  FIRST_SEEN_AT

  DOWNLOAD_COUNT

  MEDIAN_DOWNLOAD_TIME

  P90_DOWNLOAD_TIME
}

enum AppObserveUpdatesOrderByDirection {
  ASC

  DESC
}

