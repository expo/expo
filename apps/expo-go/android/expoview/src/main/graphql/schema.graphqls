type AppObserve {
  events(first: Int, after: String, last: Int, before: String, filter: AppObserveEventsFilter, orderBy: AppObserveEventsOrderBy): AppObserveEventsConnection! @deprecated(reason: "Use metrics.list instead.")

  timeSeries(input: AppObserveTimeSeriesInput!): AppObserveTimeSeries! @deprecated(reason: "Use metrics.timeSeries instead.")

  appVersions(input: AppObserveReleasesInput!): [AppObserveAppVersion!]!

  """
  Approximate count of unique users (`eas_client_id`) with at least one
  supported-metric event in `[startTime, endTime)`. Uses a ClickHouse
  HyperLogLog sketch, so the value can drift by a small percent on apps
  with very large user bases. `metricNames` on the input is currently
  ignored: the count is always over all supported metrics, matching the
  universe used by `appVersions` headline counts.
  """
  uniqueActiveUserCount(input: AppObserveReleasesInput!): Int!

  totalEventCount: Int!

  environments(platform: AppObservePlatform, "Filter to these platforms. Cannot be set together with platform." platforms: [AppObservePlatform!], startTime: DateTime, endTime: DateTime): [String!]!

  """
  Highest Expo SDK version seen in telemetry over the trailing 30 days; null when none was reported.
  """
  latestExpoSdkVersion: String

  customEventNames(platform: AppObservePlatform, "Filter to these platforms. Cannot be set together with platform." platforms: [AppObservePlatform!], startTime: DateTime!, endTime: DateTime!, environment: String, appVersion: String, appBuildNumber: String, appUpdateId: String, appEasBuildId: String, isEmbeddedUpdate: Boolean, orderBy: AppObserveCustomEventNamesOrderBy): AppObserveCustomEventNames! @deprecated(reason: "Use userEvents.names instead.")

  customEventCounts(input: AppObserveCustomEventCountsInput!): AppObserveCustomEventCounts! @deprecated(reason: "Unused; no replacement planned.")

  customEventList(first: Int, after: String, last: Int, before: String, filter: AppObserveCustomEventListFilter, orderBy: AppObserveCustomEventListOrderBy): AppObserveCustomEventListConnection! @deprecated(reason: "Use userEvents.list (or errors.occurrences for exceptions) instead.")

  """
  A single custom event by the `id` of an `AppObserveCustomEvent`. Null when the app has no
  such event, including when it has aged out of retention.
  """
  customEvent(id: ID!): AppObserveCustomEvent @deprecated(reason: "Use userEvents.event, errors.error, or log instead.")

  """
  A single metric event by the `id` of an `AppObserveEvent`. Null when the app has no such
  event, including when it has aged out of retention or the id is not one this API issued.

  `sessionEventCount` and `userEventCount` are always null here: they are aggregates over a
  time range, and a single event does not supply one.
  """
  event(id: ID!): AppObserveEvent @deprecated(reason: "Use metrics.metric instead.")

  """
  Distinct unhandled-JS-error groups (the issues list), grouped by fingerprint.
  """
  errorGroups(input: AppObserveErrorGroupsInput!): AppObserveErrorGroups! @deprecated(reason: "Use errors.groups instead.")

  """
  Headline error stats for the overview: crash-free rates and error/affected counts.
  """
  errorStats(input: AppObserveErrorStatsInput!): AppObserveErrorStats! @deprecated(reason: "Use errors.stats instead.")

  """
  Time-bucketed exception counts split into fatal vs non-fatal, for the stacked-bar chart.
  """
  errorTimeSeries(input: AppObserveErrorTimeSeriesInput!): AppObserveErrorTimeSeries! @deprecated(reason: "Use errors.timeSeries instead.")

  """
  Breaks a single error group down by app version, OS, device, or country (detail page bars).
  """
  errorGroupBreakdown(input: AppObserveErrorGroupBreakdownInput!): AppObserveErrorGroupBreakdown! @deprecated(reason: "Use errors.breakdown instead.")

  """
  Update download activity (the Recent updates list). Not available on the free tier or legacy plans.
  """
  updates(input: AppObserveUpdatesInput!): AppObserveUpdatesConnection! @deprecated(reason: "Use easUpdates.list instead.")

  navigationRoutes(first: Int, after: String, last: Int, before: String, filter: AppObserveNavigationRoutesFilter!, orderBy: AppObserveNavigationRoutesOrderBy): AppObserveNavigationRoutesConnection! @deprecated(reason: "Use navigation.routes instead.")

  """
  Active users and sessions for the Overview engagement band, across all versions.
  """
  overviewEngagement(input: AppObserveOverviewEngagementInput!): AppObserveOverviewEngagement! @deprecated(reason: "Use overview.engagement instead.")

  """
  Crash-free rates with previous-period comparison for the Overview stability tiles.
  """
  overviewStability(input: AppObserveOverviewStabilityInput!): AppObserveOverviewStability! @deprecated(reason: "Use overview.stability instead.")

  """
  Per-version, per-platform metric summaries for the Overview version-comparison matrix.
  """
  overviewVersionComparison(input: AppObserveOverviewVersionComparisonInput!): AppObserveOverviewVersionComparison! @deprecated(reason: "Use overview.versionComparison instead.")

  """
  Per-update comparison within one app version: the embedded bundle plus each OTA update.
  """
  overviewUpdateComparison(input: AppObserveOverviewUpdateComparisonInput!): AppObserveOverviewUpdateComparison! @deprecated(reason: "Use overview.updateComparison instead.")

  """
  Namespaced successor API (ENG-26160). Prefer over the flat `timeSeries`/`events`/`event` fields.
  """
  metrics: AppObserveMetrics!

  """
  Namespaced successor API (ENG-26160). Prefer over the flat `customEventNames`/`customEventList`/`customEvent` fields.
  """
  userEvents: AppObserveUserEvents!

  """
  Namespaced successor API (ENG-26160). Prefer over the flat `errorGroups`/`errorStats`/`errorTimeSeries`/`errorGroupBreakdown` fields.
  """
  errors: AppObserveErrors!

  """
  Namespaced successor API (ENG-26160). Prefer over the flat `navigationRoutes` field.
  """
  navigation: AppObserveNavigation!

  """
  Namespaced successor API (ENG-26160). Prefer over the flat `updates` field.
  """
  easUpdates: AppObserveEasUpdates!

  """
  Namespaced successor API (ENG-26160). Prefer over the flat `overview*` fields.
  """
  overview: AppObserveOverview!

  """
  One session's metrics and logs for the timeline (ENG-26160). Unknown session ids yield empty lists.
  """
  session(id: ID!): AppObserveSession!

  """
  A single log (user-defined event or error) by `event_id`. Null when missing or aged out of retention.
  """
  log(id: ID!): AppObserveLog
