"""
EAS Update download activity (app_metrics download samples plus update metadata).
"""
type AppObserveEasUpdates {
  """
  Updates with download statistics. Forward pagination only. Defaults to newest first.
  """
  list(first: Int, after: String, filter: AppObserveEasUpdatesFilter!, orderBy: AppObserveEasUpdatesOrderBy): AppObserveUpdatesConnection!
}

input AppObserveEasUpdatesFilter {
  """
  Filter to these platforms.
  """
  platforms: [AppObservePlatform!]

  startTime: DateTime!

  endTime: DateTime!

  environment: String

  appVersion: String

  appBuildNumber: String

  appUpdateId: String
}

input AppObserveEasUpdatesOrderBy {
  field: AppObserveUpdatesOrderByField!

  direction: AppObserveOrderDirection!
}

input AppObserveUpdatesInput {
  platform: AppObservePlatform

  """
  Filter to these platforms. Cannot be set together with platform.
  """
  platforms: [AppObservePlatform!]

  startTime: DateTime!

  endTime: DateTime!

  environment: String

  appVersion: String

  appBuildNumber: String

  appUpdateId: String

  first: Int

  after: String

  orderBy: AppObserveUpdatesOrderBy
}

input AppObserveUpdatesOrderBy {
  field: AppObserveUpdatesOrderByField!

  direction: AppObserveUpdatesOrderByDirection!
}

