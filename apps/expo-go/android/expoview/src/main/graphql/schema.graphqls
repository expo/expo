input WorkflowDeviceTestCaseInsightsTimespanInput {
  start: DateTime!

  end: DateTime!
}

"""
Mutually exclusive — matches the chart bucket semantics (passedClean / flaky / failed).
PASSED_CLEAN  = is_final_attempt=1 AND status=passed AND is_flaky=0
FLAKY         = is_final_attempt=1 AND is_flaky=1 (still a pass, just with retries)
FAILED        = is_final_attempt=1 AND status=failed
"""
enum WorkflowDeviceTestCaseStatusFilter {
  PASSED_CLEAN

  FLAKY

  FAILED
}

enum WorkflowDeviceTestCaseStatSortField {
  RUNS

  FAILS

  FLAKES

  PASS_RATE

  FLAKE_RATE

  P90_DURATION

  LAST_RUN
}

enum WorkflowDeviceTestCaseSortDirection {
  ASC

  DESC
}

enum WorkflowDeviceTestCaseInsightsTimeSeriesGranularity {
  MINUTE

  HOUR

  DAY
}

type WorkflowDeviceTestCaseWorkflowFacet {
  id: ID!

  name: String!
}

type WorkflowDeviceTestCaseInsightsFacets {
  gitRefs: [String!]!

  workflows: [WorkflowDeviceTestCaseWorkflowFacet!]!

  tags: [String!]!
}

"""
A count metric returned for the current window AND the equivalent prior window
(start − duration → start). The frontend uses (current, previous) to compute
trend deltas. Trend ratios are NOT pre-computed server-side — see
WorkflowsInsightsMetric for the equivalent convention.

Float (not Int) to match WorkflowsInsightsMetric and avoid the GraphQL Int32
ceiling: year-long uniqExact counts on a high-volume project can plausibly
exceed 2.1B. Values are integer-valued; the frontend reads them as JS numbers.
"""
type WorkflowDeviceTestCaseInsightsMetric {
  currentValue: Float!

  previousValue: Float!
}

"""
Same shape as WorkflowDeviceTestCaseInsightsMetric but nullable on both sides —
used for metrics like avgDurationMs / p90DurationMs where "no data in the
window" is meaningful and must not collapse to 0.
"""
type WorkflowDeviceTestCaseInsightsNullableMetric {
  currentValue: Float

  previousValue: Float
}

"""
Raw counts only (paired with previous-window values). Pass rate, flake rate,
and trends are computed in the frontend from the (currentValue, previousValue)
pair on each metric.

totalRuns = passedCleanCount + flakyCount + failedCount (over is_final_attempt=1 rows).
distinctFlakyTestCount cannot be derived in the frontend from per-test rows
because pagination means the frontend doesn't see all test paths.
"""
type WorkflowDeviceTestCaseInsightsTotals {
  totalRuns: WorkflowDeviceTestCaseInsightsMetric!

  passedCleanCount: WorkflowDeviceTestCaseInsightsMetric!

  flakyCount: WorkflowDeviceTestCaseInsightsMetric!

  failedCount: WorkflowDeviceTestCaseInsightsMetric!

  distinctFlakyTestCount: WorkflowDeviceTestCaseInsightsMetric!

  avgDurationMs: WorkflowDeviceTestCaseInsightsNullableMetric!

  p90DurationMs: WorkflowDeviceTestCaseInsightsNullableMetric!
}

"""
Mutually exclusive bucket counts (passedClean + flaky + failed = totalRuns for the bucket).
Buckets are aligned to the UTC start of the requested granularity interval
(minute / hour / day).
"""
type WorkflowDeviceTestCaseInsightsBucket {
  bucketStartAt: DateTime!

  passedClean: Int!

  flaky: Int!

  failed: Int!
}

type WorkflowDeviceTestCaseStat {
  path: String!

  name: String!

  totalRuns: Int!

  passedCleanCount: Int!

  failedCount: Int!

  flakyCount: Int!

  avgDurationMs: Int

  p90DurationMs: Int

  lastRunAt: DateTime!

  lastRunStatus: WorkflowDeviceTestCaseStatus!

  lastRunIsFlaky: Boolean!
}

type WorkflowDeviceTestCaseStatEdge {
  cursor: String!

  node: WorkflowDeviceTestCaseStat!
}

type WorkflowDeviceTestCaseStatConnection {
  edges: [WorkflowDeviceTestCaseStatEdge!]!

  pageInfo: PageInfo!

  totalCount: Int!
}

input WorkflowDeviceTestCaseInsightsFiltersInput {
  workflowIds: [ID!]

  gitRefs: [String!]

  tags: [String!]

  statuses: [WorkflowDeviceTestCaseStatusFilter!]
}

input WorkflowDeviceTestCaseHistoryFiltersInput {
  workflowIds: [ID!]

  gitRefs: [String!]
}

type WorkflowDeviceTestCaseInsights {
  totals: WorkflowDeviceTestCaseInsightsTotals!

  timeSeries(granularity: WorkflowDeviceTestCaseInsightsTimeSeriesGranularity!): [WorkflowDeviceTestCaseInsightsBucket!]!

  tests(sortField: WorkflowDeviceTestCaseStatSortField = FAILS, sortDirection: WorkflowDeviceTestCaseSortDirection = DESC, search: String, first: Int!, after: String): WorkflowDeviceTestCaseStatConnection!

  facets: WorkflowDeviceTestCaseInsightsFacets!
}

"""
Grouping key from the [shard N] prefix-stripped error_message. `count` is
computed with uniqExact(test_case_result_id) so RMT pre-merge duplicates do
not inflate it. Scope: scans ALL status='failed' rows (NOT just
is_final_attempt=1) so failures from runs that ultimately passed on retry
still surface.
"""
type WorkflowDeviceTestCaseErrorPattern {
  patternKey: String!

  sampleMessage: String!

  count: Int!

  lastSeenAt: DateTime!
}

"""
One row per execution (is_final_attempt=1). The is_flaky boolean drives the
FLAKY pill — no per-attempt timeline is exposed in v1.
"""
type WorkflowDeviceTestCaseRecentRun {
  id: ID!

  status: WorkflowDeviceTestCaseStatus!

  durationMs: Int

  isFlaky: Boolean!

  createdAt: DateTime!

  workflowRunId: ID!

  workflowRunName: String!

  gitRef: String

  commitSha: String
}

type WorkflowDeviceTestCaseRecentRunEdge {
  cursor: String!

  node: WorkflowDeviceTestCaseRecentRun!
}

type WorkflowDeviceTestCaseRecentRunConnection {
  edges: [WorkflowDeviceTestCaseRecentRunEdge!]!

  pageInfo: PageInfo!

  totalCount: Int!
}

type WorkflowDeviceTestCaseHistory {
  totals: WorkflowDeviceTestCaseInsightsTotals!

  timeSeries(granularity: WorkflowDeviceTestCaseInsightsTimeSeriesGranularity!): [WorkflowDeviceTestCaseInsightsBucket!]!

  errorPatterns(first: Int!): [WorkflowDeviceTestCaseErrorPattern!]!

  recentRuns(first: Int!, after: String): WorkflowDeviceTestCaseRecentRunConnection!
}

"""
Status of a device test case execution.
"""
enum WorkflowDeviceTestCaseStatus {
  PASSED

  FAILED
}

"""
A device test case result from a Maestro test execution.
"""
type WorkflowDeviceTestCaseResult {
  id: ID!

  name: String!

  path: String!

  status: WorkflowDeviceTestCaseStatus!

  errorMessage: String

  duration: Int

  """
  0-indexed attempt number. 0 = first attempt, 1 = first retry, etc.
  """
  retryCount: Int

  tags: [String!]

  properties: JSONObject

  createdAt: DateTime!

  updatedAt: DateTime!
}

