  EAS_BUILD

  EAS_SUBMIT

  EAS_UPDATE

  EAS_WORKFLOWS

  GITHUB_API_REQUESTS

  GITHUB_WEBHOOKS
}

"""
Possible statuses for a service.
"""
enum StatuspageServiceStatus {
  OPERATIONAL

  UNDER_MAINTENANCE

  DEGRADED_PERFORMANCE

  PARTIAL_OUTAGE

  MAJOR_OUTAGE
}

