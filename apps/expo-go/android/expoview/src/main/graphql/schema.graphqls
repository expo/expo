"""
Base interface for notification preferences
"""
interface NotificationPreference {
  type: NotificationType!

  event: NotificationEvent!

  enabled: Boolean!
}

"""
Account-level notification preference
"""
type AccountNotificationPreference implements NotificationPreference {
  type: NotificationType!

  event: NotificationEvent!

  enabled: Boolean!

  account: Account!
}

"""
App-level notification preference
"""
type AppNotificationPreference implements NotificationPreference {
  type: NotificationType!

  event: NotificationEvent!

  enabled: Boolean!

  app: App!
}

"""
Union type representing either account-level or app-level notification preferences
"""
union NotificationPreferenceItem = AccountNotificationPreference|AppNotificationPreference

enum NotificationType {
  EMAIL

  WEB
}

enum NotificationEvent {
  BUILD_COMPLETE

  BUILD_ERRORED

  SUBMISSION_COMPLETE

  SUBMISSION_ERRORED

  BUILD_PLAN_CREDIT_THRESHOLD_EXCEEDED

  BUILD_LIMIT_THRESHOLD_EXCEEDED

  TEST
}

enum BuildLimitThresholdExceededMetadataType {
  TOTAL

  IOS
}

type NotificationThresholdExceeded {
  type: BuildLimitThresholdExceededMetadataType!

  count: Int!

  limit: Int!

  threshold: Int!
}

