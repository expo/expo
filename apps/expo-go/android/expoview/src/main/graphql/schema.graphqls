  occurrences(first: Int, after: String, last: Int, before: String, filter: AppObserveErrorOccurrencesFilter, orderBy: AppObserveErrorOccurrencesOrderBy): AppObserveErrorConnection!

  """
  A single error by id. Null when missing, aged out, or the id belongs to a user-defined event.
  """
