}

type AppObserveUpdatesConnection {
  pageInfo: PageInfo!

  edges: [AppObserveUpdateEdge!]!

  totalCount: Int!

  totalDownloads: Int!
}

"""
Unhandled JS errors: app_events exception rows.
"""
type AppObserveErrors {
  """
  Distinct error groups (the issues list), grouped by fingerprint.
  """
  groups(input: AppObserveErrorsGroupsInput!): AppObserveErrorGroups!

  """
  Headline error stats: crash-free rates and error/affected counts.
  """
  stats(input: AppObserveErrorsStatsInput!): AppObserveErrorStats!

  """
  Time-bucketed exception counts split into fatal vs non-fatal.
  """
  timeSeries(input: AppObserveErrorsTimeSeriesInput!): AppObserveErrorTimeSeries!

  """
  Breaks one error group down by app version, OS, device, or country.
  """
  breakdown(input: AppObserveErrorsBreakdownInput!): AppObserveErrorGroupBreakdown!

  """
  Individual error occurrences. Defaults to newest first.
