{
  "extends": "@expo/internal-scripts/tsconfig.base",
  "compilerOptions": {
    "resolveJsonModule": true,
    "baseUrl": ".",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitAny": true
  },
  "include": ["*.tsx"]
}
