{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // TypeScript 6 no longer picks up `@types` packages implicitly, so the
    // jasmine globals the test modules rely on and the jest globals used by
    // the `__tests__` unit tests have to be listed here. The Node.js types
    // declare the `gc` global in the Blob tests and the `path` module.
    "types": ["jasmine", "jest", "node"],
    "paths": {
      "ThemeProvider": ["../common/ThemeProvider"],
      "worklets-tester": ["../bare-expo/modules/worklets-tester"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
