{
  "name": "router-tester",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "prebuild": "TEMPLATE_DIR=\"../../templates/expo-template-bare-minimum\" && (cd \"$TEMPLATE_DIR\" && PACKED_FILE=$(npm pack) && mv \"$PACKED_FILE\" pack.tgz) && npx expo prebuild --clean --template \"$TEMPLATE_DIR/pack.tgz\"",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "eas:build": "./scripts/eas.sh build",
    "eas:e2e": "./scripts/eas.sh workflow:run e2e.yml",
    "lint": "expo lint",
    "test:e2e": "./maestro/test.sh"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "expo": "workspace:*",
    "expo-constants": "workspace:*",
    "expo-dev-client": "workspace:*",
    "expo-image": "workspace:*",
    "expo-linking": "workspace:*",
    "expo-router": "workspace:*",
    "expo-splash-screen": "workspace:*",
    "expo-status-bar": "workspace:*",
    "expo-symbols": "workspace:*",
    "expo-system-ui": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0-rc.4",
    "react-native-gesture-handler": "~3.2.1",
    "react-native-pager-view": "^8.0.2",
    "react-native-reanimated": "4.7.0",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "4.28.0",
    "react-native-tab-view": "^4.3.0",
    "react-native-worklets": "0.13.0",
    "sf-symbols-typescript": "^2.0.0"
  },
  "devDependencies": {
    "@ai-sdk/openai": "^4.0.84",
    "@e2e-dev/mobile": "0.9.2",
    "@types/react": "~19.3.0",
    "ai": "^7.0.128",
    "e2e": "0.17.0"
  }
}
