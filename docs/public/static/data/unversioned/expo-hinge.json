{"schemaVersion":"2.0","name":"expo-hinge","variant":"project","kind":1,"children":[{"name":"ExpoHingeModuleEvents","variant":"declaration","kind":2097152,"children":[{"name":"hingeChange","variant":"declaration","kind":1024,"type":{"type":"reflection","declaration":{"name":"__type","variant":"declaration","kind":65536,"signatures":[{"name":"__type","variant":"signature","kind":4096,"parameters":[{"name":"event","variant":"param","kind":32768,"type":{"type":"reference","name":"HingeChangeEvent","package":"expo-hinge"}}],"type":{"type":"intrinsic","name":"void"}}]}}}]},{"name":"Hinge","variant":"declaration","kind":2097152,"comment":{"summary":[{"kind":"text","text":"State of the device hinge."}]},"children":[{"name":"angle","variant":"declaration","kind":1024,"comment":{"summary":[{"kind":"text","text":"The current angle of the hinge in degrees, where "},{"kind":"code","text":"`0`"},{"kind":"text","text":" is closed and "},{"kind":"code","text":"`180`"},{"kind":"text","text":" is flat. The rate and\ngranularity of angle updates are system policy, so do not depend on a particular update\nfrequency or precision. Prefer "},{"kind":"code","text":"`status`"},{"kind":"text","text":" when you only need to know whether the hinge is closed,\npartially open, or fully open, except on Android, where "},{"kind":"code","text":"`status`"},{"kind":"text","text":" is never "},{"kind":"code","text":"`closed`"},{"kind":"text","text":". On Android,\nthe angle comes from the hinge angle sensor."}]},"type":{"type":"intrinsic","name":"number"}},{"name":"status","variant":"declaration","kind":1024,"comment":{"summary":[{"kind":"text","text":"The current status of the hinge, determined by the system from the angle and device orientation."}]},"type":{"type":"reference","name":"HingeStatus","package":"expo-hinge"}}]},{"name":"HingeChangeEvent","variant":"declaration","kind":2097152,"children":[{"name":"hinge","variant":"declaration","kind":1024,"comment":{"summary":[{"kind":"text","text":"The current hinge, or "},{"kind":"code","text":"`null`"},{"kind":"text","text":" when the device has no hinge, the app's window provides no hinge\nupdates, or, on Android, the device has no hinge angle sensor."}]},"type":{"type":"union","types":[{"type":"reference","name":"Hinge","package":"expo-hinge"},{"type":"literal","value":null}]}}]},{"name":"HingeStatus","variant":"declaration","kind":2097152,"comment":{"summary":[{"kind":"text","text":"Status of the device hinge, as reported by the state of Jetpack WindowManager's "},{"kind":"code","text":"`FoldingFeature`"},{"kind":"text","text":"\non Android and by UIKit's "},{"kind":"code","text":"`UIHinge.Status`"},{"kind":"text","text":" on iOS. Android has no public API for a closed hinge,\nso it never reports "},{"kind":"code","text":"`closed`"},{"kind":"text","text":". It reports "},{"kind":"code","text":"`unknown`"},{"kind":"text","text":" while the app's window does not span the fold,\nsuch as on the outer screen of a closed device. To detect a closed device on Android, check for an\n"},{"kind":"code","text":"`angle`"},{"kind":"text","text":" near "},{"kind":"code","text":"`0`"},{"kind":"text","text":" with a threshold that suits your app."}]},"type":{"type":"union","types":[{"type":"literal","value":"closed"},{"type":"literal","value":"partiallyOpen"},{"type":"literal","value":"fullyOpen"},{"type":"literal","value":"unknown"}]}},{"name":"addHingeListener","variant":"declaration","kind":64,"signatures":[{"name":"addHingeListener","variant":"signature","kind":4096,"comment":{"summary":[{"kind":"text","text":"Subscribes to hinge changes. The listener is called on every angle or status change, and with a\n"},{"kind":"code","text":"`null`"},{"kind":"text","text":" hinge when the window stops providing hinge updates. Use hinge state for interactions and\neffects, not for layout."}],"blockTags":[{"tag":"@returns","content":[{"kind":"text","text":"An "},{"kind":"code","text":"`EventSubscription`"},{"kind":"text","text":" whose "},{"kind":"code","text":"`remove()`"},{"kind":"text","text":" unsubscribes the listener."}]}]},"parameters":[{"name":"listener","variant":"param","kind":32768,"comment":{"summary":[{"kind":"text","text":"A callback that is invoked with a ["},{"kind":"code","text":"`HingeChangeEvent`"},{"kind":"text","text":"](#hingechangeevent)."}]},"type":{"type":"reflection","declaration":{"name":"__type","variant":"declaration","kind":65536,"signatures":[{"name":"__type","variant":"signature","kind":4096,"parameters":[{"name":"event","variant":"param","kind":32768,"type":{"type":"reference","name":"HingeChangeEvent","package":"expo-hinge"}}],"type":{"type":"intrinsic","name":"void"}}]}}}],"type":{"type":"reference","target":{"packageName":"expo-modules-core","packagePath":"src/EventEmitter.ts","qualifiedName":"EventSubscription"},"name":"EventSubscription","package":"expo-modules-core"}}]},{"name":"getHinge","variant":"declaration","kind":64,"signatures":[{"name":"getHinge","variant":"signature","kind":4096,"comment":{"summary":[{"kind":"text","text":"Returns the current hinge state synchronously, or "},{"kind":"code","text":"`null`"},{"kind":"text","text":" when the API is unavailable, the device\nhas no hinge, or the app's window provides no hinge updates."}],"blockTags":[{"tag":"@example","content":[{"kind":"code","text":"```ts\nHinge.getHinge();\n// { angle: 120, status: 'partiallyOpen' }\n```"}]}]},"type":{"type":"union","types":[{"type":"reference","name":"Hinge","package":"expo-hinge"},{"type":"literal","value":null}]}}]},{"name":"isAvailable","variant":"declaration","kind":64,"signatures":[{"name":"isAvailable","variant":"signature","kind":4096,"comment":{"summary":[{"kind":"text","text":"Returns whether this build and OS can report the hinge: Android 11 (API level 30) or later, or\niOS 27.1 or later, built with the iOS 27.1 SDK. It does not mean the device has a hinge, which\n["},{"kind":"code","text":"`getHinge()`"},{"kind":"text","text":"](#gethinge) answers with a non-"},{"kind":"code","text":"`null`"},{"kind":"text","text":" value. Always "},{"kind":"code","text":"`false`"},{"kind":"text","text":" on web."}]},"type":{"type":"intrinsic","name":"boolean"}}]},{"name":"useHinge","variant":"declaration","kind":64,"signatures":[{"name":"useHinge","variant":"signature","kind":4096,"comment":{"summary":[{"kind":"text","text":"Returns the live hinge state and re-renders on every change. The first render already has the\ncurrent value, since the native module caches it."}],"blockTags":[{"tag":"@example","content":[{"kind":"code","text":"```tsx\nconst hinge = useHinge();\nreturn <Text>{hinge ? `${hinge.status} at ${hinge.angle}°` : 'No hinge'}</Text>;\n```"}]}]},"type":{"type":"union","types":[{"type":"reference","name":"Hinge","package":"expo-hinge"},{"type":"literal","value":null}]}}]}],"packageName":"expo-hinge"}