# Next.js hashed assets - immutable, cache forever
/_next/*
  Cache-Control: public, max-age=31536000, immutable

# llms.txt and sitemap discovery for AI agents that fetch pages without content negotiation
/*
  Link: </llms.txt>; rel="llms-txt", </sitemap.xml>; rel="sitemap"
  X-Llms-Txt: /llms.txt

/.well-known/ai-catalog.json
  Content-Type: application/ai-catalog+json
