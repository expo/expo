{
  "name": "expo-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Access system-provided on-device language models from Expo.",
  "keywords": [
    "ai",
    "expo",
    "language-models",
    "on-device",
    "react-native"
  ],
  "homepage": "https://docs.expo.dev/versions/latest/sdk/ai",
  "bugs": {
    "url": "https://github.com/expo/expo/issues"
  },
  "license": "MIT",
  "author": "650 Industries, Inc.",
  "repository": {
    "type": "git",
    "url": "https://github.com/expo/expo.git",
    "directory": "packages/expo-ai"
  },
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "expo-source": "./src/index.ts",
        "default": "./build/index.d.ts"
      },
      "expo-source": "./src/index.ts",
      "default": "./build/index.js"
    },
    "./apple": {
      "types": {
        "expo-source": "./src/apple.ts",
        "default": "./build/apple.d.ts"
      },
      "expo-source": "./src/apple.ts",
      "default": "./build/apple.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "expo-build src",
    "clean": "expo-module clean",
    "lint": "oxlint --config oxlint.config.mjs .",
    "format": "expo-module format",
    "test": "jest",
    "prepublishOnly": "expo-module prepublishOnly",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "expo": "workspace:*",
    "expo-module-scripts": "workspace:*"
  },
  "peerDependencies": {
    "expo": "*",
    "react-native": "*"
  },
  "jest": {
    "preset": "expo-module-scripts"
  }
}
