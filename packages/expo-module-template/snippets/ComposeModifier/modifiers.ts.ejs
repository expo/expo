<% const modifierName = project.composeModifierName.charAt(0).toLowerCase() + project.composeModifierName.slice(1); -%>
<% const sdk = typeof compat === 'undefined' ? {} : compat; -%>
<% if (sdk.modernExpoUI ?? true) { -%>
import { createModifier, type ModifierConfig } from '@expo/ui/jetpack-compose/modifiers';

export const <%= modifierName %> = (params: {
  color?: number;
  width?: number;
  cornerRadius?: number;
}): ModifierConfig => createModifier('<%= modifierName %>', params);
<% } else { -%>
// `ExpoModifier` is the only modifier type `@expo/ui` exports on SDK 55. It is marked deprecated
// there in favor of `ModifierConfig`, which SDK 55 does not export yet.
import type { ExpoModifier } from '@expo/ui/jetpack-compose/modifiers';

export const <%= modifierName %> = (params: {
  color?: number;
  width?: number;
  cornerRadius?: number;
}): ExpoModifier => ({ $type: '<%= modifierName %>', ...params });
<% } -%>
