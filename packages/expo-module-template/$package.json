{
  "name": "<%- project.slug %>",
  "version": "<%- project.version %>",
  "description": "<%- project.description %>",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
    "build": "node internal/module_scripts/build.js",
    "clean": "node internal/module_scripts/clean.js",
    "lint": "eslint src/",
    "test": "node internal/module_scripts/test.js",
    "prepare": "node internal/module_scripts/prepare.js",
    "open:ios": "node internal/module_scripts/open-ios.js",
    "open:android": "node internal/module_scripts/open-android.js"
  },
  "keywords": [
    "react-native",
    "expo",
    "<%- project.slug %>",
    "<%- project.name %>"
  ],
  "repository": "<%- repo %>",
  "bugs": {
    "url": "<%- repo %>/issues"
  },
  "author": "<%- author %>",
  "license": "<%- license %>",
  "homepage": "<%- repo %>#readme",
  "dependencies": {},
  "devDependencies": {
<% if (usesExpoUI) { -%>
    "@expo/ui": "~58.0.14",
<% } -%>
    "@babel/core": "^7.26.0",
    "@react-native/jest-preset": "0.88.0-rc.4",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.11",
    "eslint": "~9.39.4",
    "eslint-config-universe": "^16.1.2",
    "expo": "^58.0.6",
    "jest": "^30.0.0",
    "jest-expo": "~58.0.8",
    "prettier": "^3.0.0",
    "react": "19.3.0",
    "react-native": "0.88.0-rc.4",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src"
    ]
  },
  "peerDependencies": {
<% if (usesExpoUI) { -%>
    "@expo/ui": "*",
<% } -%>
    "expo": "*",
    "react": "*",
    "react-native": "*"
  }
}
