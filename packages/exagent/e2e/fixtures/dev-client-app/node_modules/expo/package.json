{
  "name": "expo",
  "version": "54.0.0",
  "description": "Test double of the `expo` package: a stub `expo` bin, a minimal autolinking scanner, and a short bundled native module list.",
  "main": "index.js",
  "bin": {
    "expo": "bin/cli"
  },
  "exports": {
    ".": "./index.js",
    "./bundledNativeModules.json": "./bundledNativeModules.json",
    "./internal/*": {
      "types": "./internal/*.d.ts",
      "default": "./internal/*.js"
    },
    "./*": {
      "types": "./*.d.ts",
      "default": "./*.js"
    }
  }
}
