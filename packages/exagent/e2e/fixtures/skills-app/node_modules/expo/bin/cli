#!/usr/bin/env node
// Stub `expo` bin. It stands in for the real Expo CLI, so the e2e tests can assert the
// subprocess boundary of `exagent install` and `exagent start` without network or Metro.
//
// Behavior is controlled through environment variables set by the test:
// - STUB_EXPO_EXIT_CODE: exit code to return (default 0), to test exit code forwarding
// - STUB_EXPO_DELAY_MS: milliseconds to stay alive before exiting (default 0), for `start`
// - STUB_EXPO_LOG: file the invocation is appended to (default `<cwd>/stub-expo-invocations.jsonl`)
// - STUB_EXPO_DEV_SERVER_PORT: port to report in `.expo/dev/logs/start.log` the way the real CLI
//   does, as a `metro:instantiate` event. Unset means the log is never written, which is what the
//   dev-server lock has to fall back from.
// - STUB_EXPO_STDERR: text to write to stderr before exiting, for the failures a wrapper reads out
//   of the real CLI's output (e.g. its non-interactive stop)
// - STUB_EXPO_PORT_BUSY: a port number. `start` without `--port` stops the way the real CLI stops
//   on a busy port and exits 1; `start` *with* a `--port` succeeds. That is the shape the caller
//   under test has to get past on its own, and it cannot be produced by a stateless exit code.
// - STUB_EXPO_CHECK_JSON: the object `expo install --check` prints on stdout. Unset means the run
//   printed no report at all, which is what the real CLI does when it throws PACKAGE_NOT_FOUND
//   before reaching its own reporting step.
// - STUB_EXPO_CONFIG_JSON: file whose contents `expo config` prints verbatim, for the config
//   commands. The real CLI prints one JSON object and nothing else there, so the stub prints the
//   payload last and skips its own finish line — the `stub_expo_start` line stays above it, which
//   is what makes this an honest test of the "last JSON line wins" parse.
'use strict';

const fs = require('node:fs');
const path = require('node:path');

const args = process.argv.slice(2);
const cwd = process.cwd();
const logPath = process.env.STUB_EXPO_LOG || path.join(cwd, 'stub-expo-invocations.jsonl');
const exitCode = Number(process.env.STUB_EXPO_EXIT_CODE || 0);
const delayMs = Number(process.env.STUB_EXPO_DELAY_MS || 0);
const devServerPort = process.env.STUB_EXPO_DEV_SERVER_PORT
  ? Number(process.env.STUB_EXPO_DEV_SERVER_PORT)
  : null;

// `ci` and `isTTY` are recorded because the wrapper's needs-human protocol is *about* them:
// a captured step is told `CI=1`, the dev-server step deliberately is not, and both rely on
// stdout never being a TTY (llp/0010 §Force non-interactive).
fs.appendFileSync(
  logPath,
  JSON.stringify({ args, cwd, ci: process.env.CI ?? null, isTTY: Boolean(process.stdout.isTTY) }) +
    '\n'
);

function emit(event) {
  process.stdout.write(JSON.stringify({ timestamp: Date.now(), ...event }) + '\n');
}

/** Append one `2g`-shaped event line to the structured log the real CLI writes. */
function logStructuredEvent(name, fields) {
  const startLog = path.join(cwd, '.expo', 'dev', 'logs', 'start.log');
  fs.mkdirSync(path.dirname(startLog), { recursive: true });
  fs.appendFileSync(startLog, JSON.stringify({ _e: name, _t: Date.now(), ...fields }) + '\n');
}

// `expo install --check` answers on stdout with one JSON object and exits, or throws before it
// prints one — the two shapes `exagent install --check` has to tell apart (F29). Nothing is
// emitted here, so that "no report" really is no JSON on stdout.
if (args[0] === 'install' && args.includes('--check')) {
  if (process.env.STUB_EXPO_CHECK_JSON) {
    process.stdout.write(process.env.STUB_EXPO_CHECK_JSON.trim() + '\n');
  }
  if (process.env.STUB_EXPO_STDERR) {
    process.stderr.write(process.env.STUB_EXPO_STDERR + '\n');
  }
  process.exit(exitCode);
}

emit({ type: 'stub_expo_start', command: args[0] ?? null, args });

// `expo config --json` answers on stdout and exits; nothing is started and nothing is written.
if (args[0] === 'config') {
  const payloadPath = process.env.STUB_EXPO_CONFIG_JSON;
  if (payloadPath) {
    process.stdout.write(fs.readFileSync(payloadPath, 'utf8').trim() + '\n');
  }
  process.exit(exitCode);
}

// The busy-port stop, which is recoverable rather than a question for a person: the CLI refuses
// until it is given a port, and the wrapper's job is to pick one and run again.
if (args[0] === 'start' && process.env.STUB_EXPO_PORT_BUSY) {
  const busy = process.env.STUB_EXPO_PORT_BUSY;
  const asked = args.includes('--port') ? args[args.indexOf('--port') + 1] : null;
  // Free unless it is *the* busy port: a wrapper that picked another one gets a dev server.
  if (asked != null && asked !== busy) {
    // Fall through to the ordinary `start` path below.
  } else {
    process.stderr.write(
      `Port ${busy} is running node in another window\n` +
        "Input is required, but 'npx expo' is in non-interactive mode.\n" +
        `Required input:\n> Use port ${Number(busy) + 1} instead?\n`
    );
    process.exit(1);
  }
}

if (args[0] === 'start') {
  if (devServerPort != null) {
    logStructuredEvent('metro:instantiate', { port: devServerPort });
  }
  emit({
    type: 'stub_expo_dev_server_ready',
    url: `http://localhost:${devServerPort ?? 8081}`,
  });
}

function exit() {
  emit({ type: 'stub_expo_finish', exitCode });
  if (process.env.STUB_EXPO_STDERR) {
    process.stderr.write(process.env.STUB_EXPO_STDERR + '\n');
  }
  if (exitCode !== 0) {
    process.stderr.write(`stub expo exited with code ${exitCode}\n`);
  }
  process.exit(exitCode);
}

// A signalled shutdown is a normal stop for `expo start`, so exit without an error.
for (const signal of ['SIGINT', 'SIGTERM']) {
  process.on(signal, () => {
    emit({ type: 'stub_expo_signal', signal });
    process.exit(0);
  });
}

if (delayMs > 0) {
  setTimeout(exit, delayMs);
} else {
  exit();
}
