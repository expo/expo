#!/usr/bin/env node
// Stub `@expo/fingerprint` bin. It stands in for the real CLI, so the e2e tests can exercise the
// "fingerprint matches the last build" branch of the decision table without hashing anything.
//
// The probe spawns `fingerprint fingerprint:generate <projectRoot>` and reads the last JSON line
// of stdout, so this prints one JSON object with a `hash` field.
//
// Behavior is controlled through environment variables set by the test:
// - STUB_FINGERPRINT_HASH: hash to print (default `FIXTURE_HASH` below), to simulate a change
// - STUB_FINGERPRINT_EXIT_CODE: exit code to return (default 0), to test the failure path
'use strict';

// Kept in sync by hand with `.expo/exagent-last-build.json` in this fixture: the recorded build
// matches this hash, which is what makes the fixture "fresh".
const FIXTURE_HASH = '0f1e2d3c4b5a69788796a5b4c3d2e1f001234567';

const exitCode = Number(process.env.STUB_FINGERPRINT_EXIT_CODE || 0);
if (exitCode !== 0) {
  process.stderr.write('stub fingerprint failed\n');
  process.exit(exitCode);
}

const hash = process.env.STUB_FINGERPRINT_HASH || FIXTURE_HASH;
process.stdout.write(JSON.stringify({ hash, sources: [] }) + '\n');
