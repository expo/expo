#!/usr/bin/env node
// Stub `expo` bin. It stands in for the real Expo CLI, so the e2e tests can assert the
// subprocess boundary of `exagent install` and `exagent start` without network or Metro.
//
// Behavior is controlled through environment variables set by the test:
// - STUB_EXPO_EXIT_CODE: exit code to return (default 0), to test exit code forwarding
// - STUB_EXPO_DELAY_MS: milliseconds to stay alive before exiting (default 0), for `start`
// - STUB_EXPO_LOG: file the invocation is appended to (default `<cwd>/stub-expo-invocations.jsonl`)
// - STUB_EXPO_DEV_SERVER_PORT: port to report in `.expo/dev/logs/start.log` the way the real CLI
//   does, as a `metro:instantiate` event. Unset means the log is never written, which is what the
//   dev-server lock has to fall back from.
'use strict';

const fs = require('node:fs');
const path = require('node:path');

const args = process.argv.slice(2);
const cwd = process.cwd();
const logPath = process.env.STUB_EXPO_LOG || path.join(cwd, 'stub-expo-invocations.jsonl');
const exitCode = Number(process.env.STUB_EXPO_EXIT_CODE || 0);
const delayMs = Number(process.env.STUB_EXPO_DELAY_MS || 0);
const devServerPort = process.env.STUB_EXPO_DEV_SERVER_PORT
  ? Number(process.env.STUB_EXPO_DEV_SERVER_PORT)
  : null;

fs.appendFileSync(logPath, JSON.stringify({ args, cwd }) + '\n');

function emit(event) {
  process.stdout.write(JSON.stringify({ timestamp: Date.now(), ...event }) + '\n');
}

/** Append one `2g`-shaped event line to the structured log the real CLI writes. */
function logStructuredEvent(name, fields) {
  const startLog = path.join(cwd, '.expo', 'dev', 'logs', 'start.log');
  fs.mkdirSync(path.dirname(startLog), { recursive: true });
  fs.appendFileSync(startLog, JSON.stringify({ _e: name, _t: Date.now(), ...fields }) + '\n');
}

emit({ type: 'stub_expo_start', command: args[0] ?? null, args });

if (args[0] === 'start') {
  if (devServerPort != null) {
    logStructuredEvent('metro:instantiate', { port: devServerPort });
  }
  emit({
    type: 'stub_expo_dev_server_ready',
    url: `http://localhost:${devServerPort ?? 8081}`,
  });
}

function exit() {
  emit({ type: 'stub_expo_finish', exitCode });
  if (exitCode !== 0) {
    process.stderr.write(`stub expo exited with code ${exitCode}\n`);
  }
  process.exit(exitCode);
}

// A signalled shutdown is a normal stop for `expo start`, so exit without an error.
for (const signal of ['SIGINT', 'SIGTERM']) {
  process.on(signal, () => {
    emit({ type: 'stub_expo_signal', signal });
    process.exit(0);
  });
}

if (delayMs > 0) {
  setTimeout(exit, delayMs);
} else {
  exit();
}
