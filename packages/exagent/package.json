{
  "name": "exagent",
  "version": "0.0.2",
  "description": "Agent-native CLI on top of the Expo CLI family",
  "keywords": [
    "agent",
    "expo",
    "mcp",
    "skills"
  ],
  "homepage": "https://docs.expo.dev",
  "license": "MIT",
  "author": "Expo <support@expo.dev>",
  "repository": {
    "type": "git",
    "url": "https://github.com/expo/expo.git",
    "directory": "packages/exagent"
  },
  "bin": {
    "exagent": "./bin/exagent.js"
  },
  "files": [
    "bin",
    "build"
  ],
  "main": "build/cli/index.js",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "ncc build ./src/cli.ts -o build/cli/",
    "build:prod": "ncc build ./src/cli.ts -o build/cli/ --minify --no-cache --no-source-map-register",
    "clean": "expo-module clean",
    "lint": "oxlint --config oxlint.config.mjs .",
    "format": "expo-module format",
    "typecheck": "tsc -p tsconfig.json && tsc -p e2e/tsconfig.json",
    "test": "jest",
    "test:e2e": "jest --config e2e/jest.config.js",
    "prepublishOnly": "pnpm run clean && pnpm run build:prod"
  },
  "devDependencies": {
    "2g": "^0.4.3",
    "@types/getenv": "^1.0.0",
    "@types/node": "^22.14.0",
    "@types/prompts": "^2.4.9",
    "@vercel/ncc": "^0.38.3",
    "agent-cli-detector": "0.1.6",
    "arg": "^5.0.2",
    "chalk": "^4.0.0",
    "expo-module-scripts": "workspace:*",
    "getenv": "^2.0.0",
    "memfs": "^3.2.0",
    "prompts": "^2.3.2"
  }
}
