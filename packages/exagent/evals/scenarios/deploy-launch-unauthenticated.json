{
  "id": "deploy-launch-unauthenticated",
  "fixture": "e2e/fixtures/go-app",
  "taskPrompt": "ship this app to the ios app store",
  "drivingAgent": "deterministic",
  "tiers": [0],
  "command": {
    "argv": ["deploy", "--native"],
    "env": {
      "EXPO_TOKEN": "",
      "__UNSAFE_EXPO_HOME_DIRECTORY": ".exagent-eval-no-expo-home",
      "LAUNCH_HOST": "http://127.0.0.1:1",
      "LOG_EVENTS": "events.jsonl"
    },
    "timeoutMs": 60000
  },
  "graders": [
    {
      "type": "exit-code",
      "expect": 1
    },
    {
      "type": "jsonl-event",
      "file": "events.jsonl",
      "event": "cli:error"
    }
  ]
}
