{
  "$schema": "../../tools/src/prebuilds/schemas/spm.config.schema.json",
  "products": [
    {
      "name": "ExpoApplication",
      "podName": "ExpoApplication",
      "platforms": ["iOS(\"16.4\")"],
      "externalDependencies": [
        "ReactNativeDependencies",
        "React",
        "Hermes",
        "expo-modules-core/ExpoModulesCore"
      ],
      "targets": [
        {
          "type": "objc",
          "name": "ExpoApplication_ios_objc",
          "moduleName": "ExpoApplication",
          "path": "ios/ExpoApplication",
          "pattern": "**/*.m",
          "headerPattern": "**/*.h",
          "dependencies": ["Hermes", "React", "ReactNativeDependencies"],
          "linkedFrameworks": ["Foundation", "UIKit"],
          "includeDirectories": ["."]
        },
        {
          "type": "swift",
          "name": "ExpoApplication",
          "path": "ios",
          "pattern": "*.swift",
          "dependencies": [
            "Hermes",
            "React",
            "ReactNativeDependencies",
            "expo-modules-core/ExpoModulesCore",
            "ExpoApplication_ios_objc"
          ],
          "linkedFrameworks": ["Foundation", "UIKit"],
          "resources": [{ "path": "ios/PrivacyInfo.xcprivacy", "rule": "copy" }]
        }
      ]
    }
  ]
}
