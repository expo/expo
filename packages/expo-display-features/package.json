{
  "name": "expo-display-features",
  "version": "0.1.0",
  "description": "Expo universal module for querying reserved display regions (such as a hinge or camera cutout) on foldable and dual-display devices",
  "keywords": [
    "expo",
    "expo-display-features",
    "iphone-duo",
    "foldable",
    "react-native"
  ],
  "homepage": "https://docs.expo.dev/versions/latest/sdk/display-features/",
  "bugs": {
    "url": "https://github.com/expo/expo/issues"
  },
  "license": "MIT",
  "author": "650 Industries, Inc.",
  "repository": {
    "type": "git",
    "url": "https://github.com/expo/expo.git",
    "directory": "packages/expo-display-features"
  },
  "sideEffects": false,
  "main": "build/DisplayFeatures.js",
  "types": "build/DisplayFeatures.d.ts",
  "scripts": {
    "build": "expo-build src",
    "clean": "expo-module clean",
    "lint": "oxlint --config oxlint.config.mjs .",
    "format": "expo-module format",
    "test": "jest",
    "prepublishOnly": "expo-module prepublishOnly",
    "depscheck": "expo-module depscheck",
    "typecheck": "tsc -b tsconfig.all.json"
  },
  "devDependencies": {
    "@types/jest": "^29.2.1",
    "@types/node": "^22.14.0",
    "expo": "workspace:*",
    "expo-module-scripts": "workspace:*"
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  }
}
