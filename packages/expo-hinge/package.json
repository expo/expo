{
  "name": "expo-hinge",
  "version": "58.0.0",
  "description": "Provides the device hinge angle and status on iPhone Duo.",
  "keywords": [
    "expo",
    "expo-hinge",
    "foldable",
    "hinge",
    "iphone-duo",
    "react-native"
  ],
  "homepage": "https://docs.expo.dev/versions/latest/sdk/hinge/",
  "bugs": {
    "url": "https://github.com/expo/expo/issues"
  },
  "license": "MIT",
  "author": "650 Industries, Inc.",
  "repository": {
    "type": "git",
    "url": "https://github.com/expo/expo.git",
    "directory": "packages/expo-hinge"
  },
  "sideEffects": false,
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "expo-source": "./src/index.ts",
        "default": "./build/index.d.ts"
      },
      "expo-source": "./src/index.ts",
      "default": "./build/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "expo-build src",
    "clean": "expo-module clean",
    "lint": "oxlint --config oxlint.config.mjs .",
    "format": "expo-module format",
    "swift:format": "../../scripts/swift-format.sh",
    "swift:lint": "../../scripts/swift-format.sh --lint",
    "test": "jest",
    "prepublishOnly": "expo-module prepublishOnly",
    "depscheck": "expo-module depscheck",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {},
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.2.1",
    "@types/react": "~19.3.0",
    "expo": "workspace:*",
    "expo-module-scripts": "workspace:*"
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  },
  "jest": {
    "preset": "expo-module-scripts"
  }
}
