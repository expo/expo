# Exclude all top-level hidden files and directories by convention
/.*

# Exclude nested package ignore files
**/.gitignore
**/.npmignore

# Exclude TypeScript project configuration and incremental build caches
**/tsconfig.json
**/tsconfig.all.json
**/*.tsbuildinfo

# Exclude monorepo build configuration
/turbo.json

# Exclude test configuration
**/jest.config.*
**/jest.setup.*
**/jest-setup.*

/DEVELOPMENT.md

# Exclude tarballs generated by `npm pack`
/*.tgz

__mocks__
__tests__
__rsc_tests__

/babel.config.js
/oxlint.config.mjs
/android/src/androidTest/**
/android/src/test/**

# These sqlite3 source code are copied from vendor directory during `pod install`
/ios/sqlite3.c
/ios/sqlite3.h

# Scripts only prebuild sqlite3 sources and the devtools plugin web UI
/scripts/

# Exclude source of dev-plugin-webui to reduce package size
/dev-plugin-webui/

# Include all files in dev-plugin-dist, which `prepublishOnly` generates
!/dev-plugin-dist/**/*

# Exclude native build output (pnpm pack ignores nested .gitignore files)
.cxx/**
.gradle/**
/android/build/**
