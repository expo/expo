{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "rootDir": "src",
    // Tests import `fs`; `@types/jest@30` no longer pulls in `@types/node` transitively.
    "types": ["node"]
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
