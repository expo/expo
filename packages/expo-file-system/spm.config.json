{
  "$schema": "../../tools/src/prebuilds/schemas/spm.config.schema.json",
  "publishPrebuilds": true,
  "products": [
    {
      "name": "ExpoFileSystem",
      "podName": "ExpoFileSystem",
      "platforms": ["iOS(\"16.4\")"],
      "externalDependencies": [
        "ReactNativeDependencies",
        "React",
        "Hermes",
        "expo-modules-core/ExpoModulesCore"
      ],
      "swiftLanguageVersions": ["5"],
      "targets": [
        {
          "type": "objc",
          "name": "ExpoFileSystemObjC",
          "moduleName": "ExpoFileSystem",
          "path": "ios/ExpoFileSystemObjC",
          "dependencies": ["ReactNativeDependencies", "React", "Hermes"],
          "linkedFrameworks": ["Foundation", "UIKit"]
        },
        {
          "type": "swift",
          "name": "ExpoFileSystem",
          "path": "ios",
          "dependencies": [
            "ReactNativeDependencies",
            "React",
            "Hermes",
            "expo-modules-core/ExpoModulesCore",
            "ExpoFileSystemObjC"
          ],
          "linkedFrameworks": ["Foundation", "UIKit", "QuickLook"],
          "resources": [{ "path": "ios/PrivacyInfo.xcprivacy", "rule": "copy" }]
        }
      ]
    }
  ]
}
