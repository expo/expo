{
  "$schema": "../../tools/src/prebuilds/schemas/spm.config.schema.json",
  "publishPrebuilds": true,
  "products": [
    {
      "name": "ExpoCamera",
      "podName": "ExpoCamera",
      "platforms": ["iOS(\"16.4\")"],
      "externalDependencies": [
        "ReactNativeDependencies",
        "React",
        "Hermes",
        "expo-modules-core/ExpoModulesCore"
      ],
      "targets": [
        {
          "type": "swift",
          "name": "ExpoCamera",
          "path": "ios",
          "pattern": "**/*.swift",
          "exclude": ["barcode-scanning/**"],
          "dependencies": [
            "ReactNativeDependencies",
            "React",
            "Hermes",
            "expo-modules-core/ExpoModulesCore"
          ],
          "linkedFrameworks": ["Foundation", "UIKit", "AVFoundation"]
        }
      ]
    },
    {
      "name": "ExpoCameraBarcodeScanning",
      "podName": "ExpoCameraBarcodeScanning",
      "platforms": ["iOS(\"16.4\")"],
      "autolinkWhen": {
        "podfileProperty": "expo.camera.barcode-scanner-enabled",
        "disabledValue": "false"
      },
      "externalDependencies": [],
      "spmPackages": [
        {
          "url": "https://github.com/zxingify/zxingify-objc.git",
          "productName": "ZXingObjC",
          "version": {
            "revision": "510db5f6ed293bf2f9e1905d3b8268c502f3fb55"
          }
        }
      ],
      "targets": [
        {
          "type": "swift",
          "name": "ExpoCameraBarcodeScanning",
          "path": "ios/barcode-scanning",
          "pattern": "**/*.swift",
          "dependencies": ["ExpoCamera", "ZXingObjC"],
          "compilerFlags": {
            "swift": ["-DZXINGOBJC_USE_SUBSPECS", "-DZXINGOBJC_PDF417", "-DZXINGOBJC_ONED"]
          }
        }
      ]
    }
  ]
}
