{
  "$schema": "../../tools/src/prebuilds/schemas/spm.config.schema.json",
  "products": [
    {
      "name": "ExpoLocation",
      "podName": "ExpoLocation",
      "platforms": ["iOS(\"16.4\")"],
      "externalDependencies": [
        "ReactNativeDependencies",
        "React",
        "Hermes",
        "expo-modules-core/ExpoModulesCore"
      ],
      "swiftLanguageVersions": ["5"],
      "targets": [
        {
          "type": "objc",
          "name": "ExpoLocationObjC",
          "moduleName": "ExpoLocation",
          "dependencies": ["ReactNativeDependencies", "React", "Hermes"],
          "linkedFrameworks": ["Foundation", "UIKit"]
        },
        {
          "type": "swift",
          "name": "ExpoLocation",
          "dependencies": [
            "ReactNativeDependencies",
            "React",
            "Hermes",
            "expo-modules-core/ExpoModulesCore",
            "ExpoLocationObjC"
          ],
          "linkedFrameworks": ["Foundation", "UIKit"]
        }
      ]
    },
    {
      "name": "ExpoLocationMotionActivity",
      "podName": "ExpoLocationMotionActivity",
      "platforms": ["iOS(\"16.4\")"],
      "autolinkWhen": {
        "podfileProperty": "expo.location.motionActivityEnabled",
        "disabledValue": "false"
      },
      "externalDependencies": [
        "ReactNativeDependencies",
        "React",
        "Hermes",
        "expo-modules-core/ExpoModulesCore"
      ],
      "swiftLanguageVersions": ["5"],
      "targets": [
        {
          "type": "swift",
          "name": "ExpoLocationMotionActivity",
          "path": "ios/motion-activity/ExpoLocationMotionActivity",
          "dependencies": ["ExpoLocation"],
          "linkedFrameworks": ["Foundation", "CoreMotion"]
        },
        {
          "type": "objc",
          "name": "ExpoLocationMotionActivityObjC",
          "moduleName": "ExpoLocationMotionActivity",
          "path": "ios/motion-activity/ExpoLocationMotionActivityObjC",
          "dependencies": ["ExpoLocationMotionActivity"],
          "linkedFrameworks": ["Foundation"]
        }
      ]
    }
  ]
}
