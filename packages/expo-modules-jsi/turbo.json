{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "precompile-ios": {
      "inputs": [
        "spm.config.json",
        "*.podspec",
        "apple/**",
        "!apple/.DerivedData/**",
        "!apple/.build/**",
        "!apple/.swiftpm/**",
        "!apple/.generated/**",
        "!apple/Products/**",
        "node_modules/react-native/package.json",
        "node_modules/react-native/sdks/hermes-engine/version.properties",
        "$TURBO_ROOT$/tools/src/prebuilds/**"
      ],
      "dependsOn": []
    }
  }
}
