#!/usr/bin/env node
// @ts-check
import fs from 'node:fs';
import path from 'node:path';

import { glob } from 'glob';
import resolveWorkspaceRoot from 'resolve-workspace-root';

import { checkDependenciesAsync } from '../utils/depscheck/check.js';

const { getWorkspaceGlobs, resolveWorkspaceRoot: findWorkspaceRoot } = resolveWorkspaceRoot;

/** Sub-targets that live in their own directory and are checked independently. */
const SUB_TARGETS = ['plugin', 'cli', 'utils'];

async function runAsync() {
  const packagePath = process.cwd();
  const packageJsonPath = path.join(packagePath, 'package.json');
  if (!fs.existsSync(packageJsonPath)) {
    console.error("The current working directory is not a package's root directory");
    process.exit(1);
  }

  const packageJson = JSON.parse(await fs.promises.readFile(packageJsonPath, 'utf8'));
  const workspaceRoot = findWorkspaceRoot(packagePath);
  const workspaceGlobs = workspaceRoot ? getWorkspaceGlobs(workspaceRoot) : null;
  const workspacePackageNames = new Set();
  if (workspaceRoot && workspaceGlobs) {
    const packageJsonPaths = await glob(
      workspaceGlobs.map((workspaceGlob) => `${workspaceGlob}/package.json`),
      { cwd: workspaceRoot, absolute: true }
    );
    for (const workspacePackageJsonPath of packageJsonPaths) {
      const workspacePackageJson = JSON.parse(
        await fs.promises.readFile(workspacePackageJsonPath, 'utf8')
      );
      if (workspacePackageJson.name) {
        workspacePackageNames.add(workspacePackageJson.name);
      }
    }
  }
  const pkg = { packageName: packageJson.name, packagePath, packageJson, workspacePackageNames };

  const args = process.argv.slice(2).filter((arg) => !arg.startsWith('-'));

  // Allow checking a single explicit target, e.g. `expo-module depscheck plugin`.
  // Otherwise check the package itself plus every sub-target directory that exists.
  let targets;
  if (args.length && SUB_TARGETS.includes(args[0])) {
    targets = [args[0]];
  } else {
    targets = ['package', ...SUB_TARGETS.filter((dir) => fs.existsSync(path.join(packagePath, dir)))];
  }

  const logger = {
    /** @param {string} message */
    warn: (message) => console.warn(message),
    /** @param {string} message */
    verbose: (message) => console.warn(message),
  };

  for (const target of targets) {
    await checkDependenciesAsync(pkg, /** @type {any} */ (target), logger);
  }
}

(async () => {
  try {
    await runAsync();
  } catch (error) {
    console.error(error instanceof Error ? error.message : error);
    process.exit(1);
  }
})();
