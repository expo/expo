{
  "extends": "@expo/internal-scripts/tsconfig.node",
  "include": ["./src", "./metro-require"],
  "exclude": ["**/__typetests__/*"],
  "compilerOptions": {
    "customConditions": ["expo-source", "react-native-unstable-internals"],
    "noEmit": true,
    "lib": ["dom", "esnext"],
    "rootDir": ".",
    "verbatimModuleSyntax": false,
    "types": ["jest"]
  }
}
