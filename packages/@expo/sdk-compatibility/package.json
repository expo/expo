{
  "name": "@expo/sdk-compatibility",
  "version": "0.1.0",
  "private": true,
  "description": "Canonical Expo SDK platform and toolchain compatibility data",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/expo/expo.git",
    "directory": "packages/@expo/sdk-compatibility"
  },
  "files": [
    "build"
  ],
  "sideEffects": false,
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "expo-source": "./src/index.ts",
        "default": "./build/index.d.ts"
      },
      "expo-source": "./src/index.ts",
      "default": "./build/index.js"
    },
    "./data": {
      "expo-source": "./src/sdk-compatibility.json",
      "default": "./build/sdk-compatibility.json"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "expo-build cjs:src",
    "clean": "expo-module clean",
    "lint": "oxlint --config oxlint.config.mjs .",
    "format": "expo-module format",
    "test": "jest",
    "depscheck": "expo-module depscheck",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "semver": "^7.7.4"
  },
  "devDependencies": {
    "@types/jest": "^29.2.1",
    "@types/semver": "^7.7.0",
    "expo-module-scripts": "workspace:*"
  }
}
