    "depscheck": "expo-module depscheck",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@peculiar/asn1-cms": "^2.11.1",
    "@peculiar/asn1-pfx": "^2.11.1",
