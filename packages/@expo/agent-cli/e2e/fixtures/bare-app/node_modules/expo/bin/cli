#!/usr/bin/env node
// Stub `expo` bin. It stands in for the real Expo CLI, so the e2e tests can assert the
// subprocess boundary of `@expo/agent-cli install` and `@expo/agent-cli start` without network or Metro.
//
// Behavior is controlled through environment variables set by the test:
// - STUB_EXPO_EXIT_CODE: exit code to return (default 0), to test exit code forwarding
// - STUB_EXPO_DELAY_MS: milliseconds to stay alive before exiting (default 0), for `start`
// - STUB_EXPO_LOG: file the invocation is appended to (default `<cwd>/stub-expo-invocations.jsonl`)
// - STUB_EXPO_DEV_SERVER_PORT: port to report in `.expo/dev/logs/start.log` the way the real CLI
//   does, as a `metro:instantiate` event. Unset means the log is never written, which is what the
//   dev-server lock has to fall back from. A `--port` on the command line wins over it, because a
//   real dev server listens on the port it was given.
// - STUB_EXPO_TUNNEL_HOST: host to print the way the real CLI prints a tunnelled dev server's
//   address — `Waiting on http://<host>` — and after a delay, because the real tunnel is
//   established *after* the bundler answers. That gap is the thing under test: a caller that reads
//   the log the moment the dev server is up finds the local address and no tunnel.
// - STUB_EXPO_STDERR: text to write to stderr before exiting, for the failures a wrapper reads out
//   of the real CLI's output (e.g. its non-interactive stop)
// - STUB_EXPO_PORT_BUSY: a port number. `start` without `--port` stops the way the real CLI stops
//   on a busy port and exits 1; `start` *with* a `--port` succeeds. That is the shape the caller
//   under test has to get past on its own, and it cannot be produced by a stateless exit code.
// - STUB_EXPO_CHECK_JSON: the object `expo install --check` prints on stdout, written verbatim so a
//   multi-line value stays multi-line. Unset means the run printed no report at all, which is what
//   the real CLI does when it throws PACKAGE_NOT_FOUND before reaching its own reporting step.
//   The real CLI prints the *passing* report on one line and the *failing* one pretty-printed
//   [observed - `@expo/cli` src/install/checkPackages.ts, SDK 57], which is F130's whole shape: a
//   single-line double made the parse look correct on the only case it never had to read.
// - STUB_EXPO_RUN_LAUNCH_FAILS: `run:ios` / `run:android` print what the real CLI prints for a
//   build that compiled and installed the app, then fail at the *launch* the way F121's own run
//   did. Nothing else is affected, which is the point: `prebuild` in the same plan still exits 0.
// - STUB_EXPO_CONFIG_JSON: file whose contents `expo config` prints verbatim, for the config
//   commands. The real CLI prints one JSON object and nothing else there, so the stub prints the
//   payload last and skips its own finish line — the `stub_expo_start` line stays above it, which
//   is what makes this an honest test of the "last JSON line wins" parse.
// - STUB_EXPO_BUNDLE_DELAY_MS: with STUB_EXPO_LISTEN, the entry bundle is answered this many
//   milliseconds late, which is what a dev server that has never bundled does while it transforms
//   the dependency graph. The knob a test needs to prove that a first compile is not charged to
//   the window `smoke --timeout` bounds.
// - STUB_EXPO_LISTEN: `start` binds the port it reports, answers the manifest and the entry
//   bundle, answers `GET /json/list` with an empty
//   target list — the answer that makes a dev server *reachable* to this CLI — and `GET /status` with
//   `packager-status:running` and the project root header, the way a real dev server does once its
//   bundler has finished. Without it the stub reports a port nothing listens on, which is all most
//   tests need; with it, `--wait-ready` can be driven end to end without Metro.
// - STUB_EXPO_DIE_AFTER_STATUS_MS: with STUB_EXPO_LISTEN, `start` exits 1 this many milliseconds
//   after it has answered the **first** `GET /status`, printing the macOS Automation refusal the
//   real CLI dies of. That ordering is F140's whole shape and the reason it is keyed on the request
//   rather than on the clock: the readiness probe *is* that request, so the death is guaranteed to
//   land after the claim rather than racing it [observed — 2026-08-28, `friction/run9`: `/status`
//   answered at ~450ms and the process was gone at ~700ms].
'use strict';

const fs = require('node:fs');
const http = require('node:http');
const path = require('node:path');

const args = process.argv.slice(2);
const cwd = process.cwd();
const logPath = process.env.STUB_EXPO_LOG || path.join(cwd, 'stub-expo-invocations.jsonl');
const exitCode = Number(process.env.STUB_EXPO_EXIT_CODE || 0);
const delayMs = Number(process.env.STUB_EXPO_DELAY_MS || 0);
const devServerPort = process.env.STUB_EXPO_DEV_SERVER_PORT
  ? Number(process.env.STUB_EXPO_DEV_SERVER_PORT)
  : null;

// `ci` and `isTTY` are recorded because the wrapper's needs-human protocol is *about* them:
// a captured step is told `CI=1`, the dev-server step deliberately is not, and both rely on
// stdout never being a TTY (llp/0010 §Force non-interactive).
fs.appendFileSync(
  logPath,
  JSON.stringify({ args, cwd, ci: process.env.CI ?? null, isTTY: Boolean(process.stdout.isTTY) }) +
    '\n'
);

function emit(event) {
  process.stdout.write(JSON.stringify({ timestamp: Date.now(), ...event }) + '\n');
}

/** Append one `2g`-shaped event line to the structured log the real CLI writes. */
function logStructuredEvent(name, fields) {
  const startLog = path.join(cwd, '.expo', 'dev', 'logs', 'start.log');
  fs.mkdirSync(path.dirname(startLog), { recursive: true });
  fs.appendFileSync(startLog, JSON.stringify({ _e: name, _t: Date.now(), ...fields }) + '\n');
}

// `expo install --check` answers on stdout with one JSON object and exits, or throws before it
// prints one — the two shapes `@expo/agent-cli install --check` has to tell apart (F29). Nothing is
// emitted here, so that "no report" really is no JSON on stdout.
if (args[0] === 'install' && args.includes('--check')) {
  if (process.env.STUB_EXPO_CHECK_JSON) {
    process.stdout.write(process.env.STUB_EXPO_CHECK_JSON.trim() + '\n');
  }
  if (process.env.STUB_EXPO_STDERR) {
    process.stderr.write(process.env.STUB_EXPO_STDERR + '\n');
  }
  process.exit(exitCode);
}

emit({ type: 'stub_expo_start', command: args[0] ?? null, args });

// `expo config --json` answers on stdout and exits; nothing is started and nothing is written.
if (args[0] === 'config') {
  const payloadPath = process.env.STUB_EXPO_CONFIG_JSON;
  if (payloadPath) {
    process.stdout.write(fs.readFileSync(payloadPath, 'utf8').trim() + '\n');
  }
  // A config that cannot be evaluated throws, and a thrown Node error writes its message *first*
  // and its frames after it - which is the order F133 was about. The stub can produce that shape.
  if (process.env.STUB_EXPO_STDERR) {
    process.stderr.write(process.env.STUB_EXPO_STDERR + '\n');
  }
  process.exit(exitCode);
}

// `expo run:*` is one subprocess that builds, installs *and* serves, so its failure says nothing
// about which of the three got as far as it did. This is the shape F121 is about: the compiler
// finished, the app is on the device, and the launch is what stopped [observed — wave 29,
// `evidence/07-dev-build-ios-2.log`].
if (
  (args[0] === 'run:ios' || args[0] === 'run:android') &&
  process.env.STUB_EXPO_RUN_LAUNCH_FAILS
) {
  const device = args[0] === 'run:ios' ? 'iPhone 17 Pro' : 'tuft-pixel';
  process.stdout.write(
    [
      args[0] === 'run:ios' ? '› Build Succeeded' : 'BUILD SUCCESSFUL in 4m 11s',
      `› Installing /tmp/build/app.${args[0] === 'run:ios' ? 'app' : 'apk'}`,
      `› Installing on ${device}`,
      `› Opening on ${device} (com.example.stub)`,
    ].join('\n') + '\n'
  );
  process.stderr.write(`Error: could not open the app on ${device}\n`);
  process.exit(1);
}

// The busy-port stop, which is recoverable rather than a question for a person: the CLI refuses
// until it is given a port, and the wrapper's job is to pick one and run again.
if (args[0] === 'start' && process.env.STUB_EXPO_PORT_BUSY) {
  const busy = process.env.STUB_EXPO_PORT_BUSY;
  const asked = args.includes('--port') ? args[args.indexOf('--port') + 1] : null;
  // Free unless it is *the* busy port: a wrapper that picked another one gets a dev server.
  if (asked != null && asked !== busy) {
    // Fall through to the ordinary `start` path below.
  } else {
    process.stderr.write(
      `Port ${busy} is running node in another window\n` +
        "Input is required, but 'npx expo' is in non-interactive mode.\n" +
        `Required input:\n> Use port ${Number(busy) + 1} instead?\n`
    );
    process.exit(1);
  }
}

if (args[0] === 'start') {
  // A dev server listens on the port it was given. The real CLI reports *that* port in its
  // `metro:instantiate` event, so a stub that reported the env var instead would describe a
  // dev server on a port it was never asked for — which is exactly the fact the caller under
  // test reads back out of the lock (F48-4).
  const askedPort = args.includes('--port') ? Number(args[args.indexOf('--port') + 1]) : null;
  const listeningPort = Number.isInteger(askedPort) ? askedPort : devServerPort;
  if (listeningPort != null) {
    logStructuredEvent('metro:instantiate', { port: listeningPort });
  }
  emit({
    type: 'stub_expo_dev_server_ready',
    url: `http://localhost:${listeningPort ?? 8081}`,
  });
  // The real CLI prints this once the server is up, and for a tunnelled run the URL is the tunnel
  // origin rather than the listen address (`BundlerDevServer.getDevServerUrl`). Delayed on purpose:
  // see STUB_EXPO_TUNNEL_HOST above.
  if (process.env.STUB_EXPO_TUNNEL_HOST) {
    setTimeout(() => {
      process.stdout.write(`Waiting on http://${process.env.STUB_EXPO_TUNNEL_HOST}\n`);
    }, Number(process.env.STUB_EXPO_TUNNEL_DELAY_MS || 300));
  }
  if (process.env.STUB_EXPO_LISTEN) {
    listen(listeningPort ?? 8081);
  }
}

/** Whether the death timer has already been armed, so a second probe does not arm a second one. */
let dying = false;

/**
 * Answer `GET /status` the way a dev server whose bundler has finished does, and — when the test
 * asks for it — die shortly after the first one has been answered.
 *
 * The death is an uncaught failure rather than a clean exit, because that is what `expo start --ios`
 * does when macOS refuses it Automation permission: the rejection of an un-awaited
 * `activateWindowAsync` reaches `process.on('uncaughtException')` and takes the whole dev server
 * with it, long after the port was bound.
 */
function listen(port) {
  const server = http.createServer((request, response) => {
    const route = (request.url || '').split('?')[0];
    // The inspector proxy's target list, which is how every command in this CLI decides a dev
    // server is *reachable* rather than merely listening (`src/runtime/devServer.ts`). Empty,
    // which is what a real dev server with no app attached answers, and enough to make a detached
    // stub a dev server other commands can find.
    if (route === '/json/list') {
      response.writeHead(200, { 'Content-Type': 'application/json' });
      response.end('[]');
      return;
    }
    // The Expo Updates manifest, which is the only thing that knows this project's entry bundle
    // URL (`src/runtime/bundleCheck.ts` reads `launchAsset.url` from it).
    if (route === '/' && request.headers['expo-platform']) {
      response.writeHead(200, { 'Content-Type': 'application/json' });
      response.end(
        JSON.stringify({
          id: 'stub-manifest',
          runtimeVersion: 'exposdk:57.0.0',
          launchAsset: {
            key: 'bundle',
            contentType: 'application/javascript',
            url:
              'http://127.0.0.1:' + port + '/index.bundle?platform=' +
              request.headers['expo-platform'] + '&dev=true',
          },
        })
      );
      return;
    }
    // The entry bundle, after STUB_EXPO_BUNDLE_DELAY_MS. The delay is the whole point: a dev
    // server that has never bundled transforms the dependency graph before it answers this, and
    // that first compile is what `smoke` must not charge to the window meant for reading the app.
    if (route === '/index.bundle') {
      setTimeout(() => {
        response.writeHead(200, { 'Content-Type': 'application/javascript' });
        response.end(request.method === 'HEAD' ? '' : 'var __BUNDLE_START_TIME__=0;');
      }, Number(process.env.STUB_EXPO_BUNDLE_DELAY_MS || 0)).unref();
      return;
    }
    if (route !== '/status') {
      response.writeHead(404).end();
      return;
    }
    response.writeHead(200, {
      'Content-Type': 'text/plain',
      // `encodeURI`, not `encodeURIComponent`: a real dev server leaves the separators alone, and
      // the reader decodes with `decodeURI`, which does not turn `%2F` back into `/`. Encoding the
      // whole path made this header unreadable and every project root read as another project's.
      'X-React-Native-Project-Root': encodeURI(cwd),
    });
    response.end('packager-status:running');
    const dieAfterMs = Number(process.env.STUB_EXPO_DIE_AFTER_STATUS_MS || 0);
    if (dieAfterMs > 0 && !dying) {
      dying = true;
      setTimeout(() => {
        process.stderr.write(
          'Error: osascript -e tell app "System Events" to count processes whose name is ' +
            '"Simulator" or name is "DeviceHub" exited with non-zero code: 1\n'
        );
        process.exit(1);
      }, dieAfterMs).unref();
    }
  });
  server.listen(port, '127.0.0.1');
  // Unreferenced: `STUB_EXPO_DELAY_MS` decides how long this stub lives, exactly as it does without
  // a listener, so a bound port never turns a short-lived stub into one the test has to signal.
  server.unref();
}

function exit() {
  emit({ type: 'stub_expo_finish', exitCode });
  if (process.env.STUB_EXPO_STDERR) {
    process.stderr.write(process.env.STUB_EXPO_STDERR + '\n');
  }
  if (exitCode !== 0) {
    process.stderr.write(`stub expo exited with code ${exitCode}\n`);
  }
  process.exit(exitCode);
}

// A signalled shutdown is a normal stop for `expo start`, so exit without an error.
for (const signal of ['SIGINT', 'SIGTERM']) {
  process.on(signal, () => {
    emit({ type: 'stub_expo_signal', signal });
    process.exit(0);
  });
}

if (delayMs > 0) {
  setTimeout(exit, delayMs);
} else {
  exit();
}
