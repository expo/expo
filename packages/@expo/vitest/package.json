{
  "name": "@expo/vitest",
  "version": "0.1.0",
  "private": true,
  "description": "Vitest presets for testing Expo and React Native packages (experimental)",
  "keywords": [
    "expo",
    "react-native",
    "vitest"
  ],
  "homepage": "https://github.com/expo/expo/tree/main/packages/@expo/vitest#readme",
  "bugs": {
    "url": "https://github.com/expo/expo/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/expo/expo.git",
    "directory": "packages/@expo/vitest"
  },
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./helpers": {
      "types": "./src/helpers.d.ts",
      "default": "./src/helpers.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "oxlint --config oxlint.config.mjs .",
    "format": "expo-module format",
    "depscheck": "expo-module depscheck",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@babel/core": "^7.26.0",
    "@expo/metro-config": "workspace:*",
    "@react-native/babel-preset": "0.88.0-rc.1",
    "@react-native/jest-preset": "0.88.0-rc.1",
    "@react-native/js-polyfills": "0.88.0-rc.1",
    "babel-preset-expo": "workspace:*",
    "esbuild": "^0.28.1",
    "jest-expo": "workspace:*",
    "jsdom": "^27.0.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "expo": "workspace:*",
    "expo-module-scripts": "workspace:*",
    "expo-modules-core": "workspace:*",
    "react-native": "0.88.0-rc.1",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "expo": "*",
    "expo-modules-core": "*",
    "react-native": "*",
    "vite": "*",
    "vitest": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    },
    "expo-modules-core": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  }
}
