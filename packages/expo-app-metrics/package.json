{
  "name": "expo-app-metrics",
  "version": "58.0.14",
  "description": "Replaced by expo-observe. Importing this package throws an error with the migration steps.",
  "keywords": [
    "ExpoAppMetrics",
    "expo",
    "expo-app-metrics",
    "metrics",
    "react-native"
  ],
  "homepage": "https://docs.expo.dev/",
  "license": "MIT",
  "author": "650 Industries, Inc.",
  "repository": {
    "type": "git",
    "url": "https://github.com/expo/expo.git",
    "directory": "packages/expo-app-metrics"
  },
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "expo-source": "./src/index.ts",
        "default": "./build/index.d.ts"
      },
      "expo-source": "./src/index.ts",
      "default": "./build/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "expo-build src",
    "clean": "expo-module clean",
    "lint": "oxlint --config oxlint.config.mjs .",
    "format": "expo-module format",
    "test": "jest",
    "prepack": "expo-module prepack",
    "prepublishOnly": "expo-module prepublishOnly",
    "depscheck": "expo-module depscheck",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@expo/internal-scripts": "workspace:*"
  },
  "title": "Expo App Metrics"
}
