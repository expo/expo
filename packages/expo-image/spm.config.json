{
  "$schema": "../../tools/src/prebuilds/schemas/spm.config.schema.json",
  "publishPrebuilds": true,
  "products": [
    {
      "name": "ExpoImage",
      "podName": "ExpoImage",
      "platforms": ["iOS(\"16.4\")"],
      "externalDependencies": [
        "ReactNativeDependencies",
        "React",
        "Hermes",
        "expo-modules-core/ExpoModulesCore"
      ],
      "spmPackages": [
        {
          "url": "https://github.com/SDWebImage/SDWebImage.git",
          "productName": "SDWebImage",
          "version": {
            "exact": "5.21.6"
          }
        },
        {
          "url": "https://github.com/SDWebImage/SDWebImageSVGCoder.git",
          "productName": "SDWebImageSVGCoder",
          "version": {
            "exact": "1.8.0"
          }
        }
      ],
      "prebuildDisabledWhen": [
        {
          "podfileProperty": "expo-image.enable-avif-coder",
          "value": "true"
        },
        {
          "podfileProperty": "expo-image.enable-webp-coder",
          "value": "true"
        }
      ],
      "targets": [
        {
          "type": "swift",
          "name": "ExpoImage",
          "path": "ios",
          "pattern": "**/*.swift",
          "dependencies": [
            "ReactNativeDependencies",
            "React",
            "Hermes",
            "expo-modules-core/ExpoModulesCore",
            "SDWebImage",
            "SDWebImageSVGCoder"
          ],
          "linkedFrameworks": ["Foundation", "UIKit"],
          "exclude": ["Tests/**"]
        }
      ]
    }
  ]
}
